# Hosted demo analytics (photos-demo.fly.dev only; the local app never reads these).
# Copy to .env (gitignored), fill in, then: fly secrets import -a photos-demo < search/demo/deploy/.env
# All optional: with none set, tracking silently does nothing.

# Discord webhooks (Server Settings > Integrations > Webhooks)
# fallback for every channel below
DISCORD_WEBHOOK_URL=""
# visits with no referral
DISCORD_REGULAR_VISITS_WEBHOOK_URL=""
# ?l ?r ?t ?e ?g ?c / utm_source visits; fallback for AI
DISCORD_REFERRAL_VISITS_WEBHOOK_URL=""
# visits from AI assistants + ChatGPT-User/Claude-User fetches
DISCORD_AI_VISITS_WEBHOOK_URL=""
